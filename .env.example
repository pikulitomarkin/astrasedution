# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=astraseduction
DATABASE_URL=postgresql://postgres:troque-esta-senha@db:5432/astraseduction

# NextAuth (legado / fallback)
NEXTAUTH_URL=https://astraseduction.com
NEXTAUTH_SECRET=gere-com-openssl-rand-hex-32

# FastAPI auth
JWT_SECRET=gere-com-openssl-rand-hex-32
CORS_ORIGINS=*
FREE_PLAN_CREDITS=3
NEXT_PUBLIC_API_URL=/api/v1

# Portas do Nginx no host
HTTP_PORT=80
HTTPS_PORT=443
