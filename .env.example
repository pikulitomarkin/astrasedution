# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=astraseduction
DATABASE_URL=postgresql://postgres:troque-esta-senha@db:5432/astraseduction

# NextAuth (legado / fallback)
NEXTAUTH_URL=https://astraseduction.com
NEXTAUTH_SECRET=gere-com-openssl-rand-hex-32

# FastAPI auth
JWT_SECRET=gere-com-openssl-rand-hex-32
CORS_ORIGINS=*
FREE_PLAN_CREDITS=3
NEXT_PUBLIC_API_URL=/api/v1
PUBLIC_APP_URL=https://astraseduction.com
ADMIN_API_KEY=gere-chave-admin-segura
EMAIL_DEV_EXPOSE_LINK=false
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Rate limit (por IP, janela em segundos)
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GENERATE_PER_MINUTE=10
RATE_LIMIT_WINDOW_SECONDS=60

# Email — Resend (preferencial) ou SMTP
# https://resend.com/api-keys — domínio remetente precisa estar verificado no Resend
RESEND_API_KEY=
EMAIL_FROM=Astra Seduction <noreply@astrasedution.com>
PASSWORD_RESET_EXPIRE_HOURS=2
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@astrasedution.com
SMTP_TLS=true

# Recarga
RECHARGE_BONUS_CREDITS=1000
RECHARGE_BONUS_PRICE_BRL_CENTS=4900
PAYMENT_MODE=instant

# Portas do Nginx no host
HTTP_PORT=80
HTTPS_PORT=443
